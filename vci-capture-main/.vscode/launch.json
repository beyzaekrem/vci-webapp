{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Sparrow Server",
            "type": "debugpy",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "program": "src/sparrow/server.py",
            "console": "integratedTerminal"
        },
        {
            "name": "(gdb) Sparrow Server",
            "type": "cppdbg",
            "request": "launch",
            "program": "/opt/conda/bin/python",
            "args": [
                "src/sparrow/server.py"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [
                {
                    "name": "GIBBS_BUILD_TYPE",
                    "value": "Debug"
                }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                },
                {
                    "description": "Set pending breakpoints",
                    "text": "set breakpoint pending on"
                },
            ]
        },
        {
            "name": "Pytest: Pipeline Tests",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "args": [
                "tests/pipeline",
                "-v", // Verbose output
                "-s" // Allows print statements to show in console
            ],
        },
    ]
}