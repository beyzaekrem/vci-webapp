{
  "name": "vci-webapp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "strict_build": "tsc -b && vite build",
    "build": "npm run docs || true && vite build",
    "format": "prettier . --write",
    "lint": "eslint .",
    "preview": "vite build && vite preview",
    "fetch-manual": "node ./src/Components/Parameters/XimeaManual/FetchManual.cjs",
    "docs": "npm run dependency_cruise || true && typedoc --options typedoc.json",
    "dependency_cruise": "npm run dependency_cruise:all && npm run dependency_cruise:components",
    "dependency_cruise:all": "depcruise src --output-type dot | dot -Tsvg -Grankdir=LR -Gsplines=ortho -Gconcentrate=true -Goverlap=false > deps.svg",
    "dependency_cruise:components": "depcruise -c .dependency-cruiser.components.cjs src --output-type dot | dot -Tsvg -Grankdir=LR -Gsplines=ortho -Gconcentrate=true -Goverlap=false > deps.components.svg",
    "remove-unused-imports": "eslint -c eslint.unused-imports.config.js \"src/**/*.{ts,tsx}\" --fix",
    "forward-capture-server": "ssh -L 2443:localhost:2443 vci-capture-01"
  },
  "dependencies": {
    "@rjsf/core": "^6.4.2",
    "@rjsf/react-bootstrap": "^6.4.2",
    "@rjsf/utils": "^6.4.2",
    "@rjsf/validator-ajv8": "^6.4.2",
    "ajv": "^8.18.0",
    "bootstrap": "^5.2.3",
    "bson": "^6.8.0",
    "lucide-react": "^0.511.0",
    "react": "^18.2.0",
    "react-bootstrap": "^2.7.2",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.11.1",
    "react-select": "^5.8.0",
    "rect-scaler": "^1.1.0",
    "sass": "^1.62.0",
    "vite-plugin-checker": "^0.9.1",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^20.11.19",
    "@types/react": "^18.2.56",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^4.3.4",
    "cheerio": "^1.0.0",
    "dependency-cruiser": "^17.3.8",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^15.14.0",
    "prettier": "3.4.2",
    "prettier-plugin-organize-imports": "^4.1.0",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "typedoc": "^0.28.4",
    "typescript": "^5.0.3",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.11"
  }
}
